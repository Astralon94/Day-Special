{
  "name": "day-special-server",
  "version": "0.3.13",
  "private": true,
  "type": "module",
  "description": "Day Special — planner di matrimonio per due, backend SQLite autorevole, comandi transazionali e aggiornamenti multi-dispositivo via SSE.",
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "build": "vite build && cp dist/index.html public/index.html",
    "dev": "vite",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs"
  },
  "devDependencies": {
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
